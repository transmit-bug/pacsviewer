PORT=3000
DATABASE_URL=./data/pacsviewer.db
NODE_ENV=development

# ── Security hardening (#139) ──────────────────────────────────────────────
# CORS 允许的前端来源, 多个用逗号分隔。生产走网关同源代理时可留空。
CORS_ORIGIN=http://localhost:5173

# 会话时长: 空闲超时 30 分钟 + 绝对上限 12 小时。
# refresh 轮换 token 只顺延空闲超时, 不重置绝对上限。
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# 登录/刷新限流: 窗口内 5 次失败锁 15 分钟 (按 IP+用户名)。
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15

# 初始管理员密码 (seed 时生效)。生产缺省时随机生成并打印一次,
# 且首次登录强制修改。开发环境未设置时使用 admin123 便利默认。
# INITIAL_ADMIN_PASSWORD=

# 演示登录开关 (POST /api/auth/demo-login)。仅在 NODE_ENV != production
# 时可启用; 生产构建中该路由不存在。设为 'false' 可在开发环境也关闭。
DEMO_LOGIN_ENABLED=true

# Dev fallback: serve placeholder image when real file missing
# Enabled by default in non-production. Set to 'false' to disable.
# Remove the fallback code block in routes/images.ts for production.
DEV_FALLBACK_IMAGE=true

# ── Backups (scheduled VACUUM INTO snapshots, see docs/backup-restore-runbook.md) ──
# Snapshot directory. Default: <db dir>/backups (i.e. ./data/backups)
# BACKUP_DIR=./data/backups
# Retention: newest N snapshots always kept + newest-per-day/per-ISO-week tiers.
# Defaults from docs/research/sqlite-backup-for-1.0.md.
# BACKUP_KEEP_HOURLY=48
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8
